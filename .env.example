# Relevantr server configuration (Phase 1, local development).
# Copy to .env and adjust. .env is git-ignored.

# --- Qdrant (local Docker: docker compose up -d qdrant) -------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lib_default

# --- Local paths ----------------------------------------------------------
# SQLite job ledger, manifests and (for now) the PDF folder live here.
DATA_DIR=./data
# Optional override for the PDF folder the server indexes.
# PDF_DIR=/absolute/path/to/papers

# --- Embeddings -----------------------------------------------------------
# local = Qwen3-Embedding-0.6B via sentence-transformers (dev only)
# gwdg  = hosted qwen3-embedding-4b (no local model download)
EMBEDDING_BACKEND=local

# --- Optional provider keys ----------------------------------------------
# Phase 1 can also use the OS keyring; these env vars take precedence.
GWDG_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=
